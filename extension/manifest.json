{
  "manifest_version": 3,
  "name": "Vimeo Grab",
  "short_name": "Vimeo Grab",
  "version": "2.0.0",
  "description": "Find the Vimeo videos on any page and save them as regular MP4 files: one, a few, or all at once.",
  "homepage_url": "https://github.com/grantzerlaut/vimeo-grab",
  "minimum_chrome_version": "130",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "offscreen",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.vimeo.com/*",
    "https://*.vimeocdn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vimeo Grab",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open Vimeo Grab"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; connect-src https://vimeo.com https://www.vimeo.com https://player.vimeo.com https://captions.vimeo.com https://*.vimeocdn.com; img-src 'self' data: https://*.vimeocdn.com;"
  }
}
